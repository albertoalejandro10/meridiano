# --- Auth (nuxt-auth-utils) ---
# Sealed-cookie session secret. Must be at least 32 characters in production.
# In dev, nuxt-auth-utils auto-generates one if this is unset.
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-string

# Canonical origin used in outgoing links (password reset emails). REQUIRED in
# production — it must never come from the request Host header. Unset in dev,
# where the request origin (http://localhost:3000) is used instead.
# NUXT_PUBLIC_SITE_URL=https://meridiano.app

# --- NuxtHub Database (PostgreSQL via Drizzle / postgres-js) ---
# Local development: docker compose up -d postgres  (Postgres 18 on port 5433)
DATABASE_URL="postgresql://beto_tracker:beto_tracker_password@localhost:5433/beto_tracker"

# Production: point DATABASE_URL at your managed Postgres (Neon, Supabase pooler,
# Hyperdrive, etc.). NuxtHub reads DATABASE_URL / POSTGRES_URL / POSTGRESQL_URL.

# --- AI financial digest (server/utils/ai.ts) ---
# OpenCode Go API key (https://opencode.ai/docs/go/) used server-side to generate
# the "explain my finances" digest on the Analytics page — an OpenAI-compatible
# gateway to open-weight models (currently glm-5.2). Unset in dev: the endpoint
# returns 503 instead of calling out with no key configured.
# NUXT_OPENCODE_API_KEY=...

# --- POST-MVP: Nuxt Blob Storage (transaction receipts + user avatars) ---
# Enable `hub.blob` in nuxt.config.ts and configure the blob binding/driver here.
