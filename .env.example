# Supabase — Project Settings → API Keys
# For local dev before Supabase is provisioned, keep these placeholders:
# the app renders, the API returns 401 without a session, but login is disabled.
SUPABASE_URL=https://placeholder.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser, replaces the legacy anon key
SUPABASE_KEY=sb_publishable_placeholder
# Secret key (sb_secret_...) — server-only, replaces the legacy service_role key.
# Not used yet; uncomment when server-side admin access is needed.
# SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxx

# --- Local development (docker compose up -d postgres) ---
DATABASE_URL="postgresql://beto_tracker:beto_tracker_password@localhost:5433/beto_tracker"
DIRECT_URL="postgresql://beto_tracker:beto_tracker_password@localhost:5433/beto_tracker"

# --- Supabase (production, later) — Project Settings → Database ---
# Pooled connection (Supavisor transaction mode, port 6543) — app runtime
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — Prisma migrations only (see prisma.config.ts)
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
